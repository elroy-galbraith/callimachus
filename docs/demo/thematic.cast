[56.585, "o", "PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\nPREFIX tha:  <https://ontology.example.org/thematic/>\r\n\r\n# CQ1 - which codes have been applied at least once?\r\nSELECT ?code ?label (COUNT(?excerpt) AS ?nExcerpts) WHERE {\r\n    ?code a tha:Code ;\r\n          rdfs:label ?label .\r\n    OPTIONAL { ?excerpt tha:codedAs ?code . }\r\n}\r\nGROUP BY ?code ?label\r\nORDER BY DESC(?nExcerpts) ?label\r\r\n"]
