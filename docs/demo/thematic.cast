[47.905, "o", "@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\r\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\r\n@prefix tha:  <https://ontology.example.org/thematic/> .\r\n@prefix thae: <https://ontology.example.org/thematic/entity/> .\r\n\r\nthae:interview01_excerpt_t0830\r\n    a tha:Excerpt ;\r\n    rdfs:label \"P01 on feeling excluded\"@en ;\r\n    skos:definition \"\"\"It just feels like decisions about my information happen behind closed doors...\"\"\"@en ;\r\n    dcterms:source \"Interview 01 / 08:30\" ;\r\n    tha:codedAs thae:thematic_code_feeling_shut_out ;\r\n    tha:supportsTheme thae:thematic_theme_loss_of_control ;\r\n    tha:spokenBy \"P01\" .\r\r\n"]
