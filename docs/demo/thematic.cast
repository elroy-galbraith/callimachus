[21.515, "o", "---\r\nclass: Excerpt\r\nid: interview01_excerpt_t0830\r\nlabel: P01 on feeling excluded\r\nuri: https://ontology.example.org/thematic/entity/interview01_excerpt_t0830\r\nsource_document: interview01\r\nsource_section: Interview 01 / 08:30\r\nsource_text: It just feels like decisions about my information happen behind closed doors. Nobody sits me down to explain it.\r\nproperties:\r\n  codedAs: '[[thematic_code_feeling_shut_out]]'\r\n  supportsTheme: '[[thematic_theme_loss_of_control]]'\r\n  spokenBy: P01\r\nvalidation: PASS\r\n---\r\r\n"]
